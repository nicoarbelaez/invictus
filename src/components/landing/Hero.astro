---
import { Button } from '@/components/ui/button'
import IconWrapper from '@/components/IconWrapper.astro'
---

<header>
  <div class="mx-auto max-w-xl py-24 text-center">
    <h1 class="text-base-800 text-3xl font-medium md:text-4xl">Invictus Joyas</h1>
    <p class="text-base-500 mt-2 text-sm text-balance">La calidad que mereces</p>
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a
        href="https://www.instagram.com/invictusjoyas/"
        class="inline-flex items-center gap-2"
        rel="external noreferrer noopener"
        target="_blank"
      >
        <Button>
          <IconWrapper icon="mdi:instagram" />
          <span>@invictusjoyas</span>
        </Button>
      </a>
      <a
        href="https://www.tiktok.com/@invictusjoyas"
        class="inline-flex items-center gap-2"
        rel="external noreferrer noopener"
        target="_blank"
      >
        <Button variant="secondary">
          <IconWrapper icon="ic:baseline-tiktok" />
          <span>@invictusjoyas</span>
        </Button>
      </a>
    </div>
  </div>
</header>
