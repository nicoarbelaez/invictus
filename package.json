{
  "name": "invictus-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,astro,js,mjs,json,md,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.16"
  },
  "lint-staged": {
    "apps/ecommerce/src/**/*.{astro,ts,tsx,js,mjs}": [
      "pnpm --filter ecommerce exec eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/ecommerce/*.{mjs,ts,tsx,js}": [
      "pnpm --filter ecommerce exec eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/ecommerce/src/**/*.css": [
      "prettier --write"
    ]
  }
}
