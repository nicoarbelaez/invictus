{
  "name": "invictus-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=ecommerce --filter=cms",
    "dev:web": "pnpm --filter ecommerce dev -- --port 4321 --host",
    "dev:cms": "pnpm --filter cms develop",
    "start": "pnpm dev",
    "lint": "turbo run lint --filter=ecommerce",
    "typecheck": "turbo run typecheck --filter=ecommerce",
    "check": "turbo run check --filter=ecommerce",
    "format": "prettier --write \"**/*.{ts,tsx,astro,js,mjs,json,md,css}\"",
    "cms:types": "pnpm --filter cms strapi ts:generate-types && node scripts/generate-cms-types.js",
    "prepare": "husky",
    "db:up": "docker-compose -f infra/docker-compose.yml up -d",
    "db:down": "docker-compose -f infra/docker-compose.yml down",
    "db:reset": "docker-compose -f infra/docker-compose.yml down -v && docker-compose -f infra/docker-compose.yml up -d",
    "db:logs": "docker-compose -f infra/docker-compose.yml logs -f postgres",
    "db:ps": "docker-compose -f infra/docker-compose.yml ps"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.16"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.16",
      "@types/react-dom": "^19.2.3"
    }
  },
  "lint-staged": {
    "apps/ecommerce/src/**/*.{astro,ts,tsx,js,mjs}": [
      "pnpm --filter ecommerce exec eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/ecommerce/*.{mjs,ts,tsx,js}": [
      "pnpm --filter ecommerce exec eslint --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/ecommerce/src/**/*.css": [
      "prettier --write"
    ]
  }
}
