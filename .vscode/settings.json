{
  "css.lint.unknownAtRules": "ignore",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "typescript.preferences.noUnusedLocals": true,
  "typescript.preferences.noUnusedParameters": true,
  "javascript.preferences.noUnusedLocals": true,
  "javascript.preferences.noUnusedParameters": true,
  "eslint.useFlatConfig": true,
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
