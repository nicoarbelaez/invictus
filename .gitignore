# --- Turborepo / caches ---
.turbo/
.vercel/
.output/
*.tsbuildinfo
.tsbuildinfo

# --- Dependencies & package managers ---
node_modules/
.pnpm-store/
pnpm-lock.yaml.bak
yarn-error.log*
package-lock.json
npm-shrinkwrap.json

# --- Environment & secrets ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# --- Astro / frontend build ---
apps/**/dist/
apps/**/.astro/
apps/**/.cache/
dist/
.astro/
.cache/

# --- Strapi CMS ---
apps/**/build/
apps/**/.tmp/
apps/**/.cache/
apps/**/.strapi/
apps/**/.strapi-updater.json
apps/**/.strapi-cloud.json
apps/**/exports/
build/
.tmp/
.strapi/
# Local media (keep folder via .gitkeep)
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep
*.sqlite
*.sqlite3
apps/**/*.sqlite
apps/**/*.sqlite3

# --- Logs & debugging ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Tests / Playwright ---
coverage/
.nyc_output/
.playwright-cli/
playwright-report/
test-results/
blob-report/

# --- Large binaries / installers (never commit) ---
*.exe
*.msi
*.msm
*.msp
*.dmg
*.iso
*.img
*.vmdk
*.ova
*.ovf
*.apk
*.ipa
*.deb
*.rpm
*.AppImage
*.7z
*.rar
# Large archives — keep small project zips out of the repo by default
*.zip
*.tar
*.tar.gz
*.tgz
*.gz

# --- OS & IDE ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*.tmp
*~

# --- Local / agent tooling artifacts ---
# Ignore .cursor contents, but allow safe shared config (no secrets)
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/commands/
!.cursor/commands/**
!.cursor/mcp.json

agent-transcripts/
*.canvas.tsx.bak
