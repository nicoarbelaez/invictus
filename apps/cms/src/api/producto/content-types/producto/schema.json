{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto",
    "description": "Catálogo maestro de joyería"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Titulo": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Slug": {
      "type": "uid",
      "targetField": "Titulo",
      "required": true,
      "minLength": 3,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ReferenciaSKU": {
      "type": "string",
      "required": false,
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "TipoJoya": {
      "type": "enumeration",
      "required": false,
      "default": "otro",
      "enum": [
        "anillo",
        "cadena",
        "candonga_arete",
        "pulsera_manilla",
        "dije",
        "set_juego",
        "reloj",
        "otro"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Genero": {
      "type": "enumeration",
      "enum": [
        "mujer",
        "hombre",
        "unisex",
        "infantil",
        "bebe"
      ],
      "default": "unisex",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Precio": {
      "type": "biginteger",
      "required": true,
      "min": "0",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "PrecioComparacion": {
      "type": "biginteger",
      "min": "0",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Descuento": {
      "type": "decimal",
      "min": 0,
      "max": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Stock": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Portada": {
      "type": "component",
      "repeatable": false,
      "component": "joyeria.portada-producto",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Galeria": {
      "type": "component",
      "repeatable": true,
      "component": "joyeria.foto-producto",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Categorias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::categoria.categoria",
      "inversedBy": "Productos",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Metales": {
      "type": "component",
      "repeatable": true,
      "component": "joyeria.metal",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Gemas": {
      "type": "component",
      "repeatable": true,
      "component": "joyeria.gema",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Dimensiones": {
      "type": "component",
      "repeatable": false,
      "component": "joyeria.dimensiones",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Variantes": {
      "type": "component",
      "repeatable": true,
      "component": "joyeria.variante",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Descripcion": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "DescripcionCorta": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Metadatos": {
      "type": "component",
      "repeatable": false,
      "component": "componentes.metadatos",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Destacado": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Activo": {
      "type": "boolean",
      "required": true,
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}