{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoria"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Label": {
      "type": "string",
      "minLength": 3,
      "required": true
    },
    "Slug": {
      "type": "uid",
      "required": true,
      "minLength": 3,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Producto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::producto.producto",
      "inversedBy": "Categorias"
    }
  }
}
