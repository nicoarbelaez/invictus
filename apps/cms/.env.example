############################
# Strapi Configuration
############################
# See https://docs.strapi.io/cms/configurations/environment

NODE_ENV=development

# Server (local: http://localhost:1337)
HOST=0.0.0.0
PORT=1337
# Absolute public URL of this Strapi (no trailing slash)
# Local:  http://localhost:1337
# Live:   https://cmsinvictusjoyas.arbelaeznicolas.dev
# Draft:  # PUBLIC_URL=https://cms.invictusjoyas.com
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false

# Browser CORS origins (comma-separated). Only hosts that resolve today.
# Draft later: ,https://invictusjoyas.com,https://www.invictusjoyas.com
CORS_ORIGIN=http://localhost:4321,http://127.0.0.1:4321,https://invictusjoyas.vercel.app

STRAPI_MCP_ENABLED=true
# Admin token for Cursor lives only in local .cursor/mcp.json (gitignored) — never commit

# Internationalization — default content locale (ISO code from Strapi list)
# https://docs.strapi.io/cms/features/internationalization
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=es

############################
# Database
############################
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi123
DATABASE_SSL=false

# SQLite alternative:
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

############################
# Auth (CHANGE IN PRODUCTION)
############################
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
JWT_SECRET=toBeModified
ENCRYPTION_KEY=toBeModified

CLOUDINARY_NAME=cloud_name
CLOUDINARY_KEY=api_key
CLOUDINARY_SECRET=api_secret

############################
# Deploy on content publish
############################
# Ecommerce is on Vercel now → use vercel. Switch to dokploy when the storefront moves.
DEPLOY_PROVIDER=vercel
DEPLOY_COOLDOWN_MS=60000

# Dokploy (when DEPLOY_PROVIDER=dokploy or for CMS self-redeploy)
DOKPLOY_REDEPLOY_URL=http://<host>:<port>/api/compose.redeploy
DOKPLOY_COMPOSE_ID=NCZJsjFUMk41mb5_htx2a
DOKPLOY_TITLE=Strapi - Invictus CMS Production Deploy
DOKPLOY_DESCRIPTION=Deploy automático desde Strapi (CMS) para el proyecto Invictus.
DOKPLOY_API_KEY=<api-key>

# Vercel storefront (prj_E2lW8nIleaEd7lUY5VPCssegkF4e = invictusjoyas)
VERCEL_TOKEN=<vercel-token>
VERCEL_PROJECT_ID=prj_E2lW8nIleaEd7lUY5VPCssegkF4e
