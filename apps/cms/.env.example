############################
# Strapi Configuration
############################
# See https://docs.strapi.io/cms/configurations/environment

# Node environment (development, staging, production)
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=1337

############################
# Database
############################
# PostgreSQL (default):
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi123
DATABASE_SSL=false

# For SQLite (development without dependencies, uncomment):
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

############################
# Authentication (CHANGE ALL IN PRODUCTION)
############################
# Generate each key: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS: generate 4 separate keys, join with commas
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4 # CHANGE IN PRODUCTION
API_TOKEN_SALT=toBeModified # CHANGE IN PRODUCTION
ADMIN_JWT_SECRET=toBeModified # CHANGE IN PRODUCTION
TRANSFER_TOKEN_SALT=toBeModified # CHANGE IN PRODUCTION
JWT_SECRET=toBeModified # CHANGE IN PRODUCTION
ENCRYPTION_KEY=toBeModified # CHANGE IN PRODUCTION
