# Astro storefront (server-only secrets — never expose to client)
# Local CMS:
CMS_URL=http://localhost:1337
# Live CMS (Cloudflare / Dokploy):
# CMS_URL=https://cmsinvictusjoyas.arbelaeznicolas.dev
# Draft (zone invictusjoyas.com not created yet):
# CMS_URL=https://cms.invictusjoyas.com

# Required. Create in Strapi → Settings → API Tokens (Read-only or Custom with Global find).
# Single type endpoint is /api/global (singular), not /api/globals.
CMS_TOKEN=your-strapi-api-token-read-only
