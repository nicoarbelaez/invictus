---
import BaseLayout from '@/layouts/base-layout.astro'
import { ProductList } from '@/components/share/ProductList'
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbSeparator,
  BreadcrumbPage,
} from '@/components/ui/breadcrumb'
import { productRepository } from '@/features/product/repository'

export async function getStaticPaths() {
  const categories = await productRepository.getCategories()

  return Promise.all(
    categories.map(async (cat) => ({
      params: { category: cat.slug },
      props: {
        products: await productRepository.getProductsByCategory(cat.slug),
        label: cat.label,
      },
    }))
  )
}

const { products, label } = Astro.props
---

<BaseLayout
  title={`${label} | Invictus Joyas`}
  description={`Explora nuestra colección de ${label.toLowerCase()} en oro.`}
>
  <div class="py-6 lg:py-10">
    <Breadcrumb className="mb-8">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Inicio</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{label}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <div class="mb-8">
      <h1 class="text-3xl font-medium tracking-tight">{label}</h1>
      <p class="text-muted-foreground mt-1 text-sm">
        {products.length}
        {products.length === 1 ? 'producto' : 'productos'}
      </p>
    </div>

    <ProductList products={products} client:visible={{ rootMargin: '100px' }} />
  </div>
</BaseLayout>
