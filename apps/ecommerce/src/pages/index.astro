---
import BaseLayout from '@/layouts/base-layout.astro'
import Hero from '@/components/landing/hero.astro'
import { ProductList } from '@/components/share/ProductList'
import { productRepository } from '@/features/product/repository'

const products = await productRepository.getProducts()
---

<BaseLayout>
  <Hero />
  <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-8 pt-14 lg:px-12">
    <ProductList products={products} client:visible={{ rootMargin: '200px' }} />
  </div>
</BaseLayout>
