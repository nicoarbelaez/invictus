---
import BaseLayout from '@/layouts/base-layout.astro'
import { CartCheckoutView } from '@/features/cart/components'
import { getSiteSettings } from '@/lib/cms'

const site = await getSiteSettings()
---

<BaseLayout
  title={`Carrito | ${site.siteName}`}
  description="Revisa y finaliza tu pedido de joyas en oro."
>
  <CartCheckoutView siteName={site.siteName} client:load />
</BaseLayout>
