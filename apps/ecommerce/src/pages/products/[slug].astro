---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbSeparator,
  BreadcrumbPage,
} from '@/components/ui/breadcrumb'
import { ProductPageView } from '@/features/product/components/ProductPageView'
import { productRepository } from '@/features/product/repository'

export async function getStaticPaths() {
  const products = await productRepository.getProducts()
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
const categoryLabel = product.categoryLabel ?? null
const categoryHref = product.category ? `/category/${product.category}` : null
---

<BaseLayout
  title={`${product.title} | Invictus Joyas`}
  description={product.shortDescription ?? product.description}
  image={product.images[0]?.src}
  type="product"
  productName={product.title}
  category={categoryLabel ?? undefined}
>
  <div class="container mx-auto px-4 py-6 lg:py-10">
    <Breadcrumb className="mb-8">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Inicio</BreadcrumbLink>
        </BreadcrumbItem>

        {
          categoryLabel && categoryHref && (
            <>
              <BreadcrumbSeparator />
              <BreadcrumbItem>
                <BreadcrumbLink href={categoryHref}>{categoryLabel}</BreadcrumbLink>
              </BreadcrumbItem>
            </>
          )
        }

        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{product.title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <ProductPageView product={product} client:idle={{ timeout: 300 }} />
  </div>
</BaseLayout>
