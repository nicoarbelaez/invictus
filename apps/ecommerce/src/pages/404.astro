---
import BaseLayout from '@/layouts/base-layout.astro'
import { Button } from '@/components/ui/button'
import { ProductList } from '@/components/share/ProductList'
import { Separator } from '@/components/ui/separator'
import IconWrapper from '@/components/IconWrapper.astro'
import { ChevronLeft } from 'lucide-react'
import { productRepository } from '@/features/product/repository'

const products = await productRepository.getProducts()
---

<BaseLayout
  title="Página no encontrada | Invictus Joyas"
  description="La página que buscas no existe."
  className="flex flex-col gap-28"
>
  <div class="flex flex-col items-center justify-center pt-28 text-center">
    <p class="text-muted-foreground text-sm font-medium tracking-widest uppercase">404</p>
    <h1 class="mt-4 text-3xl font-medium tracking-tight md:text-4xl">Página no encontrada</h1>
    <p class="text-muted-foreground mt-3 max-w-sm text-sm text-balance">
      La página que buscas no existe o fue movida. Vuelve al inicio para seguir explorando nuestra
      colección.
    </p>
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a href="/">
        <Button variant="outline">
          <ChevronLeft />
          <span>Volver al inicio</span>
        </Button>
      </a>

      <a
        href="https://www.instagram.com/invictusjoyas/"
        class="inline-flex items-center gap-2"
        rel="external noreferrer noopener"
        target="_blank"
      >
        <Button>
          <IconWrapper icon="mdi:instagram" />
          <span>@invictusjoyas</span>
        </Button>
      </a>

      <a
        href="https://www.tiktok.com/@invictusjoyas"
        class="inline-flex items-center gap-2"
        rel="external noreferrer noopener"
        target="_blank"
      >
        <Button variant="secondary">
          <IconWrapper icon="ic:baseline-tiktok" />
          <span>@invictusjoyas</span>
        </Button>
      </a>
    </div>
  </div>

  <Separator />

  <ProductList products={products} client:visible={{ rootMargin: '100px' }} />
</BaseLayout>
